{
  "name": "@pourledger/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "abi:generate": "node scripts/generate-registry.mjs",
    "abi:check": "node scripts/generate-registry.mjs --check",
    "release:preflight": "node scripts/deployment-preflight.mjs",
    "release:verification-input": "node scripts/verification-input.mjs",
    "release:mainnet": "node --use-env-proxy scripts/mainnet-release.mjs",
    "release:public": "node --use-env-proxy scripts/public-revision.mjs",
    "lint": "biome lint .",
    "test": "node --test test/*.test.*",
    "test:browser": "node scripts/anvil-workflow.mjs --fixture",
    "test:browser:operator": "node scripts/anvil-workflow.mjs --fixture --operator",
    "demo:local": "node scripts/anvil-workflow.mjs --fixture --serve",
    "demo:operator": "node --use-env-proxy node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 7341",
    "demo:collect": "node --use-env-proxy scripts/demo-collect.mjs",
    "smoke:visual": "node scripts/visual-smoke.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.6",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "viem": "2.58.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsqr": "1.4.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2"
  }
}
